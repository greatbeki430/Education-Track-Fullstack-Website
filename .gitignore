# Create or update .gitignore in root directory
cat > .gitignore << 'EOF'
# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment variables
.env
.env.local
.env.production.local
backend/.env
frontend/.env
frontend/.env.production

# Build outputs
dist/
build/
backend/dist/
frontend/dist/

# Database files
*.db
*.sqlite
*.sqlite3
school.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Vercel
.vercel/

# Uploads
uploads/
temp/

# Coverage
coverage/
EOF
.vercel
